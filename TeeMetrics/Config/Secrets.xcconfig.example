// Secrets.xcconfig.example — committed template
//
// Copy this file to Secrets.xcconfig (which is gitignored) and fill in
// the values. Each developer / CI environment keeps its own copy.
//
// The values are injected into Info.plist via project.yml as
// $(GOLFCOURSE_API_KEY) and read at runtime by GolfCourseAPIClient via
// Bundle.main.object(forInfoDictionaryKey: "GolfCourseAPIKey").
//
// If the key is missing or empty, online course search is silently
// disabled at runtime. Local search over bundled courses still works.

GOLFCOURSE_API_KEY =
